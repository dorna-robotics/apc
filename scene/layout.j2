inspection_poe_robot_1:
  type: "inspection_poe_robot"
  simulation: true
  # No collision box: the camera rides robot_A5, and the planner's
  # collision model only knows world-frame + flange-frame boxes — a
  # link-mounted box freezes into the WORLD wrapped around the wrist
  # and every plan starts "inside the envelope" (NO PATH). The camera
  # is compact and hugs the link; the robot's own link geometry covers
  # it, same as the d405 robot camera.
  collision_box: {body: []}
  camera_cfg:
    serial_number: "DB1119531"
    ip: "10.0.1.40"
    port: 80
  attach:
    parent_name: "core"
    parent_solid: "robot_A5"
    parent_anchor: "hole_0"
    child_solid: "body"
    child_anchor: "hole_0"
    offset: [0, 0, 0, 0, 0, 0]
