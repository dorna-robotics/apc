{# THIS unit's values — git-ignored, one per unit. core_500.j2 and
   layout.j2 import it:
       {% import "bench.j2" as bench %}  ...  ip: "{{ bench.robot_ip }}"
   New unit: copy bench.example.j2 to bench.j2 and fill it in. A name
   missing here fails the render, naming it. #}

{# simulation — robot_sim: the robot (core_500.j2); sim: every device in layout.j2 #}
{% set robot_sim     = false %}
{% set sim           = false %}

{# the rail's measured zero on THIS unit, mm (core_500.j2 rail_cfg.offset) #}
{% set rail_offset   = -94.09 %}

{# addresses #}
{% set robot_ip      = "10.0.1.10" %}
{% set vision_ip     = "10.0.1.40" %}
{% set vision_port   = 4001 %}
{% set camera_serial_station = "DB1119554" %}
{% set camera_serial_robot   = "DB1119531" %}
{% set meter_port    = "/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0" %}

{# the cameras' image, pinned — never left on auto (auto meters the whole
   frame and blows the white disc out). dev/camera/exposure.ipynb measures
   them on a disc and prints these six lines to paste here.
     exposure  µs        gain  dB (0 = no added noise)
     wb        {"once": true} settles at connect | {"ratios": {"red": r,
               "green": g, "blue": b}} pinned (1024 = unity)
   These are starting estimates from the 24 Nov fail cards — replace them
   with the notebook's numbers. #}
{% set camera_exposure_station = 43000 %}
{% set camera_gain_station     = 0 %}
{% set camera_wb_station       = {"once": true} %}
{% set camera_exposure_robot   = 18000 %}
{% set camera_gain_robot       = 0 %}
{% set camera_wb_robot         = {"once": true} %}
