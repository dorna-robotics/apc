{%- set sf = 1 -%}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}, has_motion_plan: [true, cjmove]}

# Disc in/out holders. Each Rack recipe targets the adapter_disc_holder
# and the resolver walks down to the stack_holder sitting on it (at the
# adapter's "place" anchor). Mirrors the runtime example's disc recipes.
#
# NOTE: no tool-rack / gripper recipe here — the suction gripper is
# mounted directly on the robot (no rack to pick/return it from).

# Disc stations: padding 35 — the solve minimum (min pad 32, margin
# included). Exits sit below the conservative min-end ray (102): if
# "[plan] START is inside the collision envelope" shows up after
# places, raise this or slim the stack_holder boxes.
# --- IN sources ---
disc_in_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_1, ref_joints: [-71.8, -27.9, -19.6, 0.0, -42.6, 108.2, 232.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

disc_in_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_2, ref_joints: [-59.0, -25.2, -26.6, 0.0, -38.2, 121.0, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# --- OUT good ---
disc_out_good_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_1, ref_joints: [-54.7, -17.3, -52.9, 0.0, -19.8, 125.3, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

disc_out_good_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_2, ref_joints: [-49.2, -14.7, -68.1, 0.0, -7.2, 130.8, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# --- OUT bad (rejected) ---
disc_out_bad_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_bad_1, ref_joints: [-42.3, -14.4, -78.4, 0.0, 2.8, 137.7, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# ── Stations ────────────────────────────────────────────────────────
# Inspection — present the held disc to the camera + run detect().
inspector:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_horizontal_1, ref_joints: [-48.9, 27.3, -117.3, -0.9, 0.0, 132.0, -9.0, 0.0], base_distance: 195, rail_step: 5, rail_span: 0, detection_preset: {frames_avg: 4, display: {label: 0, save_img: false, save_img_roi: "/home/dorna/captures/apc/"}}, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# Robot-camera inspector — the core-mounted D405 (no component, no
# motion surface): inspects the disc ON the anode right after placing,
# before the measurement. ROI comes per-call from actions.py as a 3D
# box on the anode place anchor, projected per frame (vision-guide §5).
inspector_robot:
  class: workspace.recipes.inspector.Inspector
  kwargs: {detection_preset: {frames_avg: 4, display: {label: 0, save_img: false, save_img_roi: false}}, speed_factor: {{ sf }}}

# Anode — place/pick the disc on the anode's "place" anchor (Scale recipe
# = base Recipe with target_anchor="place"; gives pick/place over a fixed
# station, same as placing on the scale pan).
anode:
  class: workspace.recipes.scale.Scale
  kwargs: {component: anode_1, ref_joints: [-69.2, 13.6, -89.9, 0.0, -13.7, 110.8, 18.8, 0.0], base_distance: 175, rail_step: 5, rail_span: 0, padding: 60, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# Multimeter — read the disc's capacitance while it's clamped anode↔cathode.
meter:
  class: workspace.recipes.multi_meter.MultiMeter
  kwargs: {component: multi_meter_1}
