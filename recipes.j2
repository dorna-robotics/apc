{%- set sf = 1 -%}
{#- Planned-travel primitive for every recipe — one knob, like sf.
    [true, cjmove] = certified cont-jmove chains; [true, smove] = one
    spline through the fold (watch sparse planner segments — the
    known smove caveat). -#}
{%- set hmp = "[true, smove]" -%}
{#- Every detection's settings live in vision/ (beside this file), one
    config per model with the model beside it: vision/disc_od.yaml,
    vision/disc_cls.yaml. A relative path is relative to the file it is
    written in — config: to this file, the paths inside a config to
    vision/. -#}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# Disc in/out holders. Each Rack recipe targets the adapter_disc_holder
# and the resolver walks down to the stack_holder sitting on it (at the
# adapter's "place" anchor). Mirrors the runtime example's disc recipes.
#
# NOTE: no tool-rack / gripper recipe here — the suction gripper is
# mounted directly on the robot (no rack to pick/return it from).

# Disc stations: padding 35 — the solve minimum (min pad 32, margin
# included). Exits sit below the conservative min-end ray (102): if
# "[plan] START is inside the collision envelope" shows up after
# places, raise this or slim the stack_holder boxes.
# --- IN sources ---
disc_in_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_1, ref_joints: [-71.8, -27.9, -19.6, 0.0, -42.6, 108.2, 232.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

disc_in_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_2, ref_joints: [-59.0, -25.2, -26.6, 0.0, -38.2, 121.0, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# --- OUT good ---
disc_out_good_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_1, ref_joints: [-54.7, -17.3, -52.9, 0.0, -19.8, 125.3, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

disc_out_good_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_2, ref_joints: [-49.2, -14.7, -68.1, 0.0, -7.2, 130.8, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# --- OUT bad (rejected) ---
disc_out_bad_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_bad_1, ref_joints: [-42.3, -14.4, -78.4, 0.0, 2.8, 137.7, 162.5, 0.0], left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, padding: 35, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# ── Stations ────────────────────────────────────────────────────────
# Two models per camera, so TWO Inspector recipes per camera, each owning
# one named detection on the same camera (Inspector.detection_name):
#   *      — the disc DETECTOR (od). Owns the motion too: present() on
#            the station form. Runs on the WHOLE frame — no ROI.
#   *_cls  — the pass/fail CLASSIFIER (cls). Never moves; actions.py runs
#            it on the detector's box grown by CLS_ROI_OFFSET px, cropped.
# The station pair share the station's solved pose (same ref_joints — the
# IK cache answers the second one).
# Every detection setting (model, conf, frames_avg, display) is in its
# vision/ config; recipes.j2 only names it.

# Vertical station — the held disc, bottom side.
inspector:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_poe_vertical_1, detection_name: bottom_od, ref_joints: [-48.9, 27.3, -117.3, -0.9, 0.0, 132.0, -9.0, 0.0], base_distance: 195, rail_step: 5, rail_span: 0, detection_preset: {config: vision/disc_od.yaml}, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

inspector_cls:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_poe_vertical_1, detection_name: bottom_cls, ref_joints: [-48.9, 27.3, -117.3, -0.9, 0.0, 132.0, -9.0, 0.0], base_distance: 195, rail_step: 5, rail_span: 0, detection_preset: {config: vision/disc_cls.yaml}, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# Robot camera — inspection_poe_robot_1, the PoE camera riding the arm
# (a component like any station, no motion surface): the disc ON the
# anode right after placing, before the measurement, top side.
inspector_robot:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_poe_robot_1, detection_name: top_od, detection_preset: {config: vision/disc_od.yaml}, speed_factor: {{ sf }}}

inspector_robot_cls:
  class: workspace.recipes.inspector.Inspector
  kwargs: {component: inspection_poe_robot_1, detection_name: top_cls, detection_preset: {config: vision/disc_cls.yaml}, speed_factor: {{ sf }}}

# Anode — plain base Recipe: pick/place the disc on the anode's "place"
# anchor. Everything is explicit here — no station class inherited.
# fuse: false — the arm must park CLEAR after the place, BEFORE the
# cathode plunges; a held exit would leave the tool hovering over the
# disc through the cathode cycle. (PickAnode re-enables fusing per call
# for its exit -> sort travel.)
anode:
  class: workspace.recipes.recipe.Recipe
  kwargs: {component: anode_1, target_anchor: place, fuse: false, ref_joints: [-69.2, 13.6, -89.9, 0.0, -13.7, 110.8, 18.8, 0.0], base_distance: 175, rail_step: 5, rail_span: 0, padding: 60, speed_factor: {{ sf }}, has_motion_plan: {{ hmp }}}

# Multimeter — read the disc's capacitance while it's clamped anode↔cathode.
meter:
  class: workspace.recipes.multi_meter.MultiMeter
  kwargs: {component: multi_meter_1}
