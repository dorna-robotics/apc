{%- set sf = 0.5 -%}

# Robot (generic): base Recipe with NO component. Owns no station, does no
# boot-time IK — the stable handle for robot-level Start/Park calls
# (park(joint=...), motor). Same across every project.
robot:
  class: workspace.recipes.recipe.Recipe
  kwargs: {speed_factor: {{ sf }}, has_motion_plan: [true, cjmove]}

# Disc in/out holders. Each Rack recipe targets the adapter_disc_holder
# and the resolver walks down to the stack_holder sitting on it (at the
# adapter's "place" anchor). Mirrors the runtime example's disc recipes.
#
# NOTE: no tool-rack / gripper recipe here — the suction gripper is
# mounted directly on the robot (no rack to pick/return it from).

# Disc stations: padding 55 — bench-tuned (110 from the solve min-end
# read hovered too high and flipped the place IK branch). If "[plan]
# START is inside the collision envelope" shows up after places, the
# stack_holder boxes are the knob, not this number.
# --- IN sources ---
disc_in_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_1, left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], padding: 55, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

disc_in_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_in_2, left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], padding: 55, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# --- OUT good ---
disc_out_good_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_1, left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], padding: 55, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

disc_out_good_2:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_good_2, left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], padding: 55, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# --- OUT bad (rejected) ---
disc_out_bad_1:
  class: workspace.recipes.rack.Rack
  kwargs: {component: adapter_disc_out_bad_1, left_approach: true, base_distance: 250, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], padding: 55, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# ── Stations ────────────────────────────────────────────────────────
# Inspection — present the held disc to the camera + run detect().
inspector:
  class: workspace.recipes.inspector.FixedInspector
  kwargs: {component: inspection_horizontal_1, base_distance: 195, rail_step: 5, rail_span: 0, detection_preset: {}, speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# Anode — place/pick the disc on the anode's "place" anchor (Scale recipe
# = base Recipe with target_anchor="place"; gives pick/place over a fixed
# station, same as placing on the scale pan).
anode:
  class: workspace.recipes.scale.Scale
  kwargs: {component: anode_1, base_distance: 175, rail_step: 5, rail_span: 0, target_offset: [0, 0, 300, 0, 0, 0], speed_factor: {{ sf }}, has_motion_plan: [true, clmove]}

# Multimeter — read the disc's capacitance while it's clamped anode↔cathode.
meter:
  class: workspace.recipes.multi_meter.MultiMeter
  kwargs: {component: multi_meter_1}
